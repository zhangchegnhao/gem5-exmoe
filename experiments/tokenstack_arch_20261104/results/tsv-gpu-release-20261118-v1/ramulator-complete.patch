+      m_priority_buffer.max_size = 512*3 + 32;
+    };
+
+    bool tokenstack_enabled() const override { return m_tokenstack; }
+    size_t blocked_cycles() const override { return s_external_block_cycles; }
+
+    void block_commands_until(Clk_t boundary) override {
+      if (!m_tokenstack || boundary < m_clk) {
