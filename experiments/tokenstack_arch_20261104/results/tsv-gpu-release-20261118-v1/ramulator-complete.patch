+        for lch in range(math.ceil(valid_channel)):
+          addr = addr_offset + lch * HBM_GS['ch'] + rank * HBM_GS['rank']
+          hex_addr = hex(addr)[2:]
+          cmd_context_mvsb[itr][-1].append("PIM_MV_SB 0x{0:0>8}".format(hex_addr))
