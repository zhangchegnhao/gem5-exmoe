diff --git a/src/frontend/impl/memory_trace/pim_loadstore_trace.cpp b/src/frontend/impl/memory_trace/pim_loadstore_trace.cpp
new file mode 100644
index 0000000..07ea19b
--- /dev/null
+++ b/src/frontend/impl/memory_trace/pim_loadstore_trace.cpp
@@ -0,0 +1,174 @@
+#include <filesystem>
+#include <iostream>
+#include <fstream>
+#include <cmath>
+
+#include "frontend/frontend.h"
+#include "base/exception.h"
+
+namespace Ramulator {
+
+namespace fs = std::filesystem;
+
+class PIMLoadStoreTrace : public IFrontEnd, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IFrontEnd, PIMLoadStoreTrace, "PIMLoadStoreTrace", "PIM/Load/Store memory address trace.")
+
+  private:
+    struct Trace {
+      int req_type;
+      Addr_t addr;
+    };
+    std::vector<Trace> m_trace;
+
+    size_t m_trace_length = 0;
+    size_t m_curr_trace_idx = 0;
+
+    size_t m_trace_count = 0;
+
+    Logger_t m_logger;
+    std::ofstream m_completion_trace;
+    int m_tck_ps = 0;
+
+  public:
+    void init() override {
+      std::string trace_path_str = param<std::string>("path").desc("Path to the load store trace file.").required();
+      m_clock_ratio = param<uint>("clock_ratio").required();
+
+      std::string completion_path = param<std::string>("completion_path")
+        .desc("Optional PIM request completion trace path.")
+        .default_val("");
+      if (!completion_path.empty()) {
+        fs::path path(completion_path);
+        if (!path.parent_path().empty()) {
+          fs::create_directories(path.parent_path());
+        }
+        m_completion_trace.open(path, std::ios::out | std::ios::trunc);
+        if (!m_completion_trace.is_open()) {
+          throw ConfigurationError("Completion trace {} cannot be opened!", completion_path);
+        }
+        m_completion_trace << "schema_version,source_id,type_id,address,channel,arrive_cycle,retire_cycle,tck_ps,event\n";
+      }
+
+      m_logger = Logging::create_logger("LoadStoreTrace");
+      m_logger->info("Loading trace file {} ...", trace_path_str);
+      init_trace(trace_path_str);
+      m_logger->info("Loaded {} lines.", m_trace.size());
+    };
+
+    void setup(IFrontEnd* frontend, IMemorySystem* memory_system) override {
+      m_tck_ps = static_cast<int>(std::lround(memory_system->get_tCK() * 1000.0f));
+    }
+
+    void finalize() override {
+      if (m_completion_trace.is_open()) {
+        m_completion_trace.flush();
+      }
+      IFrontEnd::finalize();
+    }
+
+    void tick() override {
+      if (is_finished()) {
+        return;
+      }
+      bool req_full = false;
+      while(!req_full && !is_finished()) {
+        const Trace& t = m_trace[m_curr_trace_idx];
+        bool request_sent = false;
+        Request request{t.addr, t.req_type};
+        request.source_id = static_cast<int>(m_trace_count);
+        if (m_completion_trace.is_open()) {
+          request.callback = [this](Request& completed) {
+            m_completion_trace << "1," << completed.source_id << ","
+                               << completed.type_id << ","
+                               << completed.addr << ","
+                               << completed.addr_vec[0] << ","
+                               << completed.arrive << ","
+                               << completed.depart << "," << m_tck_ps << ","
+                               << (completed.type_id == Request::Type::PIM_BARRIER
+                                   ? "barrier_removed" : "final_command_issued") << "\n";
+          };
+        }
+        request_sent = m_memory_system->send(request);
+        if (request_sent) {
+          m_curr_trace_idx = (m_curr_trace_idx + 1) % m_trace_length;
+          m_trace_count++;
+        }
+        else {
+          req_full = true;
+        }
+      }
+    };
+
+
+  private:
+    void init_trace(const std::string& file_path_str) {
+      fs::path trace_path(file_path_str);
+      if (!fs::exists(trace_path)) {
+        throw ConfigurationError("Trace {} does not exist!", file_path_str);
+      }
+
+      std::ifstream trace_file(trace_path);
+      if (!trace_file.is_open()) {
+        throw ConfigurationError("Trace {} cannot be opened!", file_path_str);
+      }
+
+      std::string line;
+      while (std::getline(trace_file, line)) {
+        std::vector<std::string> tokens;
+        tokenize(tokens, line, " ");
+
+        // TODO: Add line number here for better error messages
+        if (tokens.size() != 2) {
+          throw ConfigurationError("Trace {} format invalid!", file_path_str);
+        }
+
+        int req_type = -1; 
+        if (tokens[0] == "LD") {
+          req_type = 0;
+        } else if (tokens[0] == "ST") {
+          req_type = 1;
+        } else if (tokens[0] == "PIM_MAC_AB") {
+          req_type = 4;
+        } else if (tokens[0] == "PIM_MAC_SB") {
+          req_type = 5;
+        } else if (tokens[0] == "PIM_MAC_PB") {
+          req_type = 6;
+        } else if (tokens[0] == "PIM_WR_GB") {
+          req_type = 7;
+        } else if (tokens[0] == "PIM_MV_SB") {
+          req_type = 8;
+        } else if (tokens[0] == "PIM_MV_GB") {
+          req_type = 9;
+        } else if (tokens[0] == "PIM_SFM") {
+          req_type = 10;
+        } else if (tokens[0] == "PIM_SET_MODEL") {
+          req_type = 11;
+        } else if (tokens[0] == "PIM_SET_HEAD") {
+          req_type = 12;
+        } else if (tokens[0] == "PIM_BARRIER") {
+          req_type = 13;
+        } else {
+          throw ConfigurationError("Trace {} format invalid!", file_path_str);
+        }
+
+        Addr_t addr = -1;
+        if (tokens[1].compare(0, 2, "0x") == 0 | tokens[1].compare(0, 2, "0X") == 0) {
+          addr = std::stoll(tokens[1].substr(2), nullptr, 16);
+        } else {
+          addr = std::stoll(tokens[1]);
+        }
+        m_trace.push_back({req_type, addr});
+      }
+
+      trace_file.close();
+
+      m_trace_length = m_trace.size();
+    };
+
+    // TODO: FIXME
+    bool is_finished() override {
+      return m_trace_count >= m_trace_length; 
+    };
+};
+
+}        // namespace Ramulator
diff --git a/src/frontend/impl/memory_trace/tokenstack_graph.cpp b/src/frontend/impl/memory_trace/tokenstack_graph.cpp
new file mode 100644
index 0000000..5c93599
--- /dev/null
+++ b/src/frontend/impl/memory_trace/tokenstack_graph.cpp
@@ -0,0 +1,165 @@
+#include <algorithm>
+#include <fstream>
+#include <map>
+#include <set>
+#include "frontend/frontend.h"
+#include "memory_system/tokenstack_fabric.h"
+namespace Ramulator {
+// Trace DAG executor: timing is live, dependencies are completed callbacks, not
+// precomputed offline latency sums. Numerical payload validation is separate.
+class TokenStackGraph final : public IFrontEnd, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IFrontEnd, TokenStackGraph, "TokenStackGraph", "Versioned hardware task DAG.");
+  struct Op { int type; Addr_t address; int id; uint32_t mask; };
+  struct Task {
+    std::string id, source, resource;
+    std::string acquire,release;
+    std::string page_lock;
+    int group=0;
+    size_t buffer_bytes=0;
+    std::vector<std::string> dependencies;
+    std::vector<Op> operations;
+    int stack=0, state=0;
+    Clk_t issue=0, eligible=-1, start=-1, end=-1, cycles=0, served=-1;
+    size_t bytes=0, sent=0, returned=0;
+  };
+  std::vector<Task> m_tasks;
+  std::map<std::string,size_t> m_index;
+  ITokenStackFabric* m_fabric=nullptr;
+  Clk_t m_timeout=0;
+  size_t m_done=0;
+  std::ofstream m_log, m_requests,m_buffers;
+  size_t m_group_capacity=0,m_buffer_peak=0;
+  int m_groups=0;
+  Clk_t m_aging=0;
+  std::map<int,size_t> m_used;
+  std::map<std::string,std::pair<int,size_t>> m_allocations;
+  std::map<std::string,std::string> m_locks,m_allocation_locks;
+  static void check(bool ok,const std::string& msg) { if(!ok) throw ConfigurationError("TokenStackGraph: {}",msg); }
+  void complete(size_t index, Clk_t end) {
+    auto& task=m_tasks[index]; check(task.state==1,"duplicate task completion");
+    if(!task.release.empty()) {
+      check(m_allocations.count(task.release),"release without allocation");
+      const auto allocation=m_allocations.at(task.release);
+      check(m_used[allocation.first]>=allocation.second,"buffer underflow");
+      m_used[allocation.first]-=allocation.second;
+      m_buffers<<"1,"<<task.release<<','<<allocation.first<<','<<end<<",release,"<<allocation.second<<','<<m_used[allocation.first]<<'\n';
+      m_allocations.erase(task.release);
+      if(m_allocation_locks.count(task.release)) {
+        m_locks.erase(m_allocation_locks.at(task.release));m_allocation_locks.erase(task.release);
+      }
+    }
+    task.state=2; task.end=end; ++m_done;
+    m_log<<"1,"<<index<<','<<task.id<<','<<task.source<<','<<task.issue<<','<<task.eligible<<','<<task.start<<','<<end
+         <<','<<task.bytes<<','<<task.operations.size()<<'\n';
+  }
+ public:
+  void init() override {
+    m_clock_ratio=param<uint>("clock_ratio").required(); check(m_clock_ratio==1,"requires 1:1 clock");
+    m_timeout=param<Clk_t>("max_cycles").required(); check(m_timeout>0,"invalid timeout");
+    m_group_capacity=param<size_t>("buffer_bytes_per_group").required();m_groups=param<int>("head_groups").required();
+    m_aging=param<Clk_t>("aging_cycles").required();
+    check(m_group_capacity>0 && m_groups>0 && m_aging>0,"invalid buffer/groups/fairness");
+    auto input=YAML::LoadFile(param<std::string>("path").required());
+    check(input["schema_version"].as<int>()==1 && input["tasks"].IsSequence(),"invalid graph schema");
+    int request_id=0;
+    for(auto node:input["tasks"]) {
+      Task task; task.id=node["id"].as<std::string>(); task.source=node["source"].as<std::string>();
+      check(task.source=="gpu"||task.source=="pim"||task.source=="promotion"||task.source=="demotion","invalid task source");
+      check(!task.id.empty() && task.id.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-")==std::string::npos
+            && !m_index.count(task.id),"invalid/duplicate task ID");
+      task.issue=node["issue_cycle"] ? node["issue_cycle"].as<Clk_t>() : 0;
+      check(task.issue>=0,"negative issue cycle");
+      if(node["depends_on"]) task.dependencies=node["depends_on"].as<std::vector<std::string>>();
+      if(node["acquire"]) {
+        task.acquire=node["acquire"].as<std::string>();task.group=node["buffer_group"].as<int>();task.buffer_bytes=node["buffer_bytes"].as<size_t>();
+        check(task.group>=0 && task.group<m_groups && task.buffer_bytes>0 && task.buffer_bytes<=m_group_capacity,"invalid/oversized page buffer allocation");
+        if(node["page_lock"]) task.page_lock=node["page_lock"].as<std::string>();
+      }
+      if(node["release"]) task.release=node["release"].as<std::string>();
+      if(node["requests"]) for(auto req:node["requests"]) {
+        uint64_t mask=req["byte_mask"]?req["byte_mask"].as<uint64_t>():0xffffffff;
+        check(mask>0 && mask<=0xffffffff,"invalid burst byte mask");
+        task.operations.push_back({req["type"].as<int>(),req["address"].as<Addr_t>(),request_id++,uint32_t(mask)});
+      }
+      if(node["resource"]) {
+        check(task.operations.empty(),"task cannot mix work and memory");
+        task.resource=node["resource"].as<std::string>(); task.stack=node["stack"].as<int>();
+        task.bytes=node["bytes"].as<size_t>(); task.cycles=node["cycles"].as<Clk_t>();
+      }
+      check(task.acquire.empty() || (task.operations.empty() && task.resource.empty()),"allocation must be its own graph node");
+      m_index[task.id]=m_tasks.size(); m_tasks.push_back(task);
+    }
+    check(!m_tasks.empty(),"empty graph");
+    std::set<std::string> reachable;
+    for(size_t pass=0;pass<m_tasks.size();++pass) for(const auto& task:m_tasks) {
+      for(const auto& dep:task.dependencies) check(m_index.count(dep),"missing dependency");
+      if(std::all_of(task.dependencies.begin(),task.dependencies.end(),[&](auto dep){return reachable.count(dep);})) reachable.insert(task.id);
+    }
+    check(reachable.size()==m_tasks.size(),"dependency cycle");
+    m_log.open(param<std::string>("task_log").required()); m_requests.open(param<std::string>("request_log").required());
+    m_buffers.open(param<std::string>("buffer_log").required());
+    check(m_log.is_open() && m_requests.is_open() && m_buffers.is_open(),"cannot open logs");
+    m_buffers<<"schema_version,page_id,head_group,cycle,event,bytes,occupied_bytes\n";
+    m_log<<"schema_version,task_index,task_id,source,issue_cycle,eligible_cycle,start_cycle,complete_cycle,bytes,requests\n";
+    m_requests<<"schema_version,request_id,task_index,type,address,accept_cycle,complete_cycle,byte_mask\n";
+    register_stat(m_buffer_peak).name("page_buffer_peak_bytes_per_group");
+  }
+  void setup(IFrontEnd*, IMemorySystem* memory) override {
+    m_fabric=dynamic_cast<ITokenStackFabric*>(memory); check(m_fabric,"requires TokenStackFabric");
+  }
+  void tick() override {
+    check(m_clk<m_timeout,"simulation timeout");
+    std::vector<size_t> order;
+    for(size_t i=0;i<m_tasks.size();++i) {
+      auto& task=m_tasks[i];if(task.state==2 || task.issue>m_clk)continue;
+      if(!std::all_of(task.dependencies.begin(),task.dependencies.end(),[&](auto dep){return m_tasks[m_index.at(dep)].state==2;}))continue;
+      if(task.eligible<0)task.eligible=m_clk;
+      order.push_back(i);
+    }
+    auto priority=[](const std::string& source){return source=="gpu"||source=="pim"?0:source=="promotion"?1:2;};
+    std::stable_sort(order.begin(),order.end(),[&](size_t a,size_t b){
+      const auto& x=m_tasks[a];const auto& y=m_tasks[b];bool xa=m_clk-x.eligible>=m_aging,ya=m_clk-y.eligible>=m_aging;
+      // Equal-age tasks rotate by last successful admission. Fixed index order
+      // lets early channels refill a bounded source queue and starve the rest.
+      return std::make_tuple(!xa,xa?0:priority(x.source),x.eligible,x.served,a)<std::make_tuple(!ya,ya?0:priority(y.source),y.eligible,y.served,b);
+    });
+    for(size_t i:order) {
+      auto& task=m_tasks[i]; if(task.state==2 || task.issue>m_clk) continue;
+      bool ready=std::all_of(task.dependencies.begin(),task.dependencies.end(),[&](auto dep){return m_tasks[m_index.at(dep)].state==2;});
+      if(!ready) continue;
+      if(task.eligible<0) task.eligible=m_clk;
+      if(task.state==0 && !task.acquire.empty()) {
+        if(m_used[task.group]+task.buffer_bytes>m_group_capacity)continue;
+        if(!task.page_lock.empty() && m_locks.count(task.page_lock))continue;
+        check(!m_allocations.count(task.acquire),"page allocated twice");
+        if(!task.page_lock.empty()) {m_locks[task.page_lock]=task.acquire;m_allocation_locks[task.acquire]=task.page_lock;}
+        m_allocations[task.acquire]={task.group,task.buffer_bytes};m_used[task.group]+=task.buffer_bytes;
+        m_buffer_peak=std::max(m_buffer_peak,m_used[task.group]);
+        m_buffers<<"1,"<<task.acquire<<','<<task.group<<','<<m_clk<<",allocate,"<<task.buffer_bytes<<','<<m_used[task.group]<<'\n';
+      }
+      if(!task.resource.empty()) {
+        if(task.state==1) continue;
+        if(m_fabric->work(int(i),task.stack,task.resource,task.bytes,task.cycles,task.source,[this,i](Clk_t end){complete(i,end);})) {
+          task.state=1; task.start=m_clk;task.served=m_clk;
+        }
+      } else {
+        if(task.state==0) {task.state=1;task.start=m_clk;}
+        if(task.operations.empty()) {complete(i,m_clk);continue;}
+        if(task.sent<task.operations.size()) {
+          auto op=task.operations[task.sent]; const auto accept=m_clk;
+          Request req(op.address,op.type); req.source_id=op.id;
+          req.callback=[this,i,op,accept](Request& done){
+            auto& owner=m_tasks[i];
+            m_requests<<"1,"<<op.id<<','<<i<<','<<op.type<<','<<op.address<<','<<accept<<','<<done.depart<<','<<op.mask<<'\n';
+            if(++owner.returned==owner.operations.size()) complete(i,done.depart);
+          };
+          if(m_fabric->submit(req,task.source)) {++task.sent;task.served=m_clk;}
+        }
+      }
+    }
+    ++m_clk;
+  }
+  bool is_finished() override {return m_done==m_tasks.size();}
+  void finalize() override {check(is_finished() && m_allocations.empty(),"unfinished graph or leaked page buffer");m_log.flush();m_requests.flush();m_buffers.flush();IFrontEnd::finalize();}
+};
+}
diff --git a/src/frontend/impl/memory_trace/tokenstack_trace.cpp b/src/frontend/impl/memory_trace/tokenstack_trace.cpp
new file mode 100644
index 0000000..1031ae9
--- /dev/null
+++ b/src/frontend/impl/memory_trace/tokenstack_trace.cpp
@@ -0,0 +1,350 @@
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <fstream>
+#include <limits>
+#include <set>
+
+#include "frontend/frontend.h"
+#include "addr_mapper/addr_mapper.h"
+#include "dram_controller/controller.h"
+#include "dram_controller/tokenstack_controller.h"
+#include "memory_system/tokenstack_memory.h"
+
+namespace Ramulator {
+
+// Closed-loop, conservative transaction-level Base Die driver. DRAM commands
+// still use the original cycle-level HBM3-PIM controller/device. Supports the
+// legacy single domain or an optional two-domain TokenStackMemory backend.
+class TokenStackTrace final : public IFrontEnd, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IFrontEnd, TokenStackTrace, "TokenStackTrace",
+                                    "Single-channel TokenStack closed-loop trace driver.");
+  private:
+    struct Operation { int type; Addr_t address; };
+    struct Job {
+      std::string id, kind;
+      Clk_t issue = 0, eligible = -1, admitted = -1, start = -1, complete = -1;
+      std::vector<std::string> dependencies;
+      std::vector<Operation> operations;
+      size_t logical = 0, read_bytes = 0, write_bytes = 0;
+      Addr_t source = 0, target = 0;
+      int state = 0;  // 0 unreleased, 1 queued, 2 active, 3 done
+      int priority() const { return kind == "attention" || kind == "access" ? 0 : kind == "promotion" ? 1 : 2; }
+    };
+    enum class Phase { PIM, Read, SourceLink, TargetLink, Write };
+    std::vector<Job> m_jobs;
+    std::vector<size_t> m_queue;
+    int m_active = -1;
+    Phase m_phase = Phase::PIM;
+    size_t m_sent = 0, m_returned = 0, m_expected = 0, m_done = 0;
+    int m_next_request_id = 0;
+    size_t m_buffer_bytes = 0, m_buffer_peak = 0, m_queue_peak = 0;
+    size_t m_buffer_capacity = 0, m_queue_depth = 0, m_burst_bytes = 0;
+    size_t m_compressed_num = 0, m_compressed_den = 0;
+    Addr_t m_capacity_base = 0, m_compute_base = 0, m_region_bytes = 0;
+    Clk_t m_link_until = -1, m_max_cycles = 0;
+    int m_tck_ps = 0, m_read_latency = 0, m_write_latency = 0;
+    double m_link_GBps = 0;
+    size_t m_admission_block_cycles = 0, m_send_retries = 0;
+    size_t m_actual_block_cycles = 0;
+    IDRAM* m_dram = nullptr;
+    IAddrMapper* m_mapper = nullptr;
+    IDRAMController* m_controller = nullptr;
+    ITokenStackController* m_gate = nullptr;
+    ITokenStackMemory* m_layers = nullptr;
+    std::array<IDRAM*, 2> m_layer_drams{};
+    std::array<IDRAMController*, 2> m_layer_controllers{};
+    std::ofstream m_requests, m_job_events, m_resources;
+
+    static void require(bool condition, const std::string& message) {
+      if (!condition) throw ConfigurationError("TokenStack: {}", message);
+    }
+
+    static int operation_type(const std::string& op) {
+      static const std::map<std::string, int> types = {
+        {"PIM_MAC_AB", 4}, {"PIM_MAC_SB", 5}, {"PIM_MAC_PB", 6},
+        {"PIM_WR_GB", 7}, {"PIM_MV_SB", 8}, {"PIM_MV_GB", 9},
+        {"PIM_SFM", 10}, {"PIM_SET_MODEL", 11}, {"PIM_SET_HEAD", 12},
+        {"PIM_BARRIER", 13}};
+      auto it = types.find(op);
+      require(it != types.end(), "unsupported attention operation " + op);
+      return it->second;
+    }
+
+    void open_log(std::ofstream& out, const std::string& key, const std::string& header) {
+      out.open(param<std::string>(key).required());
+      require(out.is_open(), "cannot open " + key);
+      if (!header.empty()) out << header << '\n';
+    }
+
+  public:
+    void init() override {
+      m_clock_ratio = param<uint>("clock_ratio").required();
+      m_buffer_capacity = param<size_t>("buffer_bytes").required();
+      m_queue_depth = param<size_t>("queue_depth").required();
+      m_burst_bytes = param<size_t>("burst_bytes").required();
+      m_capacity_base = param<Addr_t>("capacity_base").required();
+      m_compute_base = param<Addr_t>("compute_base").required();
+      m_region_bytes = param<Addr_t>("region_bytes").required();
+      m_compressed_num = param<size_t>("compressed_num").required();
+      m_compressed_den = param<size_t>("compressed_den").required();
+      m_link_GBps = param<double>("base_die_link_GBps").required();
+      m_max_cycles = param<Clk_t>("max_cycles").required();
+      require(m_clock_ratio == 1 && m_queue_depth > 0 && m_buffer_capacity > 0
+              && m_burst_bytes > 0 && m_max_cycles > 0, "invalid clock/queue/buffer/burst/timeout");
+      require(m_compressed_num > 0 && m_compressed_num <= m_compressed_den,
+              "invalid compressed byte ratio");
+      require(std::isfinite(m_link_GBps) && m_link_GBps > 0, "invalid link bandwidth");
+      require(m_capacity_base >= 0 && m_compute_base >= 0 && m_region_bytes > 0,
+              "invalid layer regions");
+      require(m_region_bytes <= std::numeric_limits<Addr_t>::max() - std::max(m_capacity_base, m_compute_base),
+              "layer region overflow");
+      require(m_capacity_base + m_region_bytes <= m_compute_base
+              || m_compute_base + m_region_bytes <= m_capacity_base, "layer regions overlap");
+      require(m_capacity_base % m_burst_bytes == 0 && m_compute_base % m_burst_bytes == 0
+              && m_region_bytes % m_burst_bytes == 0, "unaligned layer region");
+
+      auto trace = YAML::LoadFile(param<std::string>("path").required());
+      require(trace["schema_version"].as<int>() == 1 && trace["jobs"].IsSequence(), "unsupported workload schema");
+      std::set<std::string> ids;
+      for (auto entry : trace["jobs"]) {
+        Job job;
+        job.id = entry["id"].as<std::string>();
+        require(!job.id.empty() && job.id.find_first_not_of("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_-")
+                == std::string::npos && ids.insert(job.id).second, "invalid/duplicate job id");
+        job.kind = entry["kind"].as<std::string>();
+        require(job.kind == "attention" || job.kind == "access" || job.kind == "promotion" || job.kind == "demotion", "invalid job kind");
+        job.issue = entry["issue_cycle"].as<Clk_t>();
+        require(job.issue >= 0 && job.issue < m_max_cycles, "issue cycle out of range");
+        if (entry["depends_on"]) job.dependencies = entry["depends_on"].as<std::vector<std::string>>();
+        if (job.kind == "attention" || job.kind == "access") {
+          require(entry["requests"].IsSequence() && entry["requests"].size() > 0, "empty attention requests");
+          std::string layer = job.kind == "access" ? entry["layer"].as<std::string>() : "compute";
+          require(layer == "capacity" || layer == "compute", "invalid access layer");
+          // One operation per diagnostic access job makes dependency ordering
+          // explicit and avoids interpreting read-after-write forwarding as RD.
+          require(job.kind != "access" || entry["requests"].size() == 1, "access job requires one request");
+          for (auto request : entry["requests"]) {
+            Addr_t offset = request["offset"].as<Addr_t>();
+            require(offset >= 0 && offset < m_region_bytes && offset % m_burst_bytes == 0, "invalid PIM offset");
+            std::string op = request["op"].as<std::string>();
+            int type = job.kind == "access" ? (op == "LD" ? 0 : op == "ST" ? 1 : -1) : operation_type(op);
+            require(type >= 0, "unsupported access operation");
+            job.operations.push_back({type, (layer == "capacity" ? m_capacity_base : m_compute_base) + offset});
+          }
+        } else {
+          job.logical = entry["logical_bytes"].as<size_t>();
+          require(job.logical > 0 && job.logical <= m_buffer_capacity && job.logical <= size_t(m_region_bytes),
+                  "migration exceeds buffer/region or is empty (chunking unsupported)");
+          require(job.logical <= std::numeric_limits<size_t>::max() / m_compressed_num
+                  && (job.logical * m_compressed_num) % m_compressed_den == 0, "fractional/overflow compressed bytes");
+          size_t compressed = job.logical * m_compressed_num / m_compressed_den;
+          job.read_bytes = job.kind == "promotion" ? compressed : job.logical;
+          job.write_bytes = job.kind == "promotion" ? job.logical : compressed;
+          Addr_t offset = entry["offset"].as<Addr_t>();
+          require(offset >= 0 && offset <= m_region_bytes - Addr_t(job.logical)
+                  && offset % m_burst_bytes == 0 && job.read_bytes % m_burst_bytes == 0
+                  && job.write_bytes % m_burst_bytes == 0, "migration alignment/bounds failure");
+          job.source = (job.kind == "promotion" ? m_capacity_base : m_compute_base) + offset;
+          job.target = (job.kind == "promotion" ? m_compute_base : m_capacity_base) + offset;
+        }
+        m_jobs.push_back(std::move(job));
+      }
+      require(!m_jobs.empty(), "empty workload");
+      // Reject missing dependencies and cycles, instead of hanging at runtime.
+      std::set<std::string> reachable;
+      for (size_t pass = 0; pass < m_jobs.size(); ++pass) {
+        for (const auto& job : m_jobs) {
+          for (const auto& dep : job.dependencies) require(ids.count(dep), "unknown dependency " + dep);
+          if (std::all_of(job.dependencies.begin(), job.dependencies.end(),
+                          [&](const auto& dep) { return reachable.count(dep); })) reachable.insert(job.id);
+        }
+      }
+      require(reachable.size() == m_jobs.size(), "dependency cycle");
+      open_log(m_requests, "request_log", "");  // schema chosen after backend setup
+      open_log(m_job_events, "job_log", "schema_version,job_id,kind,issue_cycle,eligible_cycle,admit_cycle,start_cycle,complete_cycle,logical_bytes,read_bytes,write_bytes");
+      open_log(m_resources, "resource_log", "schema_version,job_id,resource,start_cycle,end_cycle,bytes");
+      register_stat(m_buffer_peak).name("tokenstack_buffer_peak_bytes");
+      register_stat(m_queue_peak).name("tokenstack_queue_peak_jobs");
+      register_stat(m_admission_block_cycles).name("tokenstack_admission_block_cycles");
+      register_stat(m_send_retries).name("tokenstack_send_retries");
+      register_stat(m_tck_ps).name("tokenstack_tck_ps");
+      register_stat(m_actual_block_cycles).name("tokenstack_controller_block_cycles");
+      register_stat(m_read_latency).name("tokenstack_read_latency_cycles");
+      register_stat(m_write_latency).name("tokenstack_write_recovery_cycles");
+    }
+
+    void setup(IFrontEnd*, IMemorySystem* memory) override {
+      m_layers = dynamic_cast<ITokenStackMemory*>(memory);
+      require(memory->get_clock_ratio() == 1 && (m_layers || memory->m_impl->get_name() == "PIMDRAM"), "requires PIMDRAM or TokenStackMemory at 1:1 clock");
+      if (m_layers) require(m_layers->layer_base(0) == m_capacity_base && m_layers->layer_base(1) == m_compute_base
+                            && m_layers->region_bytes() == m_region_bytes, "frontend/backend layer map mismatch");
+      for (int layer = 0; layer < 2; ++layer) {
+        auto* backend = m_layers ? m_layers->layer_memory(layer) : memory;
+        auto* dram = backend->get_ifce<IDRAM>();
+        auto* mapper = backend->get_ifce<IAddrMapper>();
+        m_layer_drams[layer] = dram;
+        m_layer_controllers[layer] = backend->get_ifce<IDRAMController>();
+        require(dram->get_level_size("channel") == 1 && mapper->m_impl->get_name() == "HBM3-PIM", "only single-channel HBM3-PIM mapping supported");
+        require(m_burst_bytes == size_t(dram->m_internal_prefetch_size * dram->m_channel_width / 8), "burst_bytes differs from DRAM transfer size");
+      }
+      m_dram = m_layer_drams[1];
+      m_controller = m_layer_controllers[1];
+      m_mapper = (m_layers ? m_layers->layer_memory(1) : memory)->get_ifce<IAddrMapper>();
+      m_gate = m_layers ? static_cast<ITokenStackController*>(m_layers) : dynamic_cast<ITokenStackController*>(m_controller);
+      require(m_gate && m_gate->tokenstack_enabled(), "requires enabled closed-loop HBM3-PIM controller");
+      require(m_dram->get_level_size("channel") == 1 && m_mapper->m_impl->get_name() == "HBM3-PIM",
+              "only single-channel HBM3-PIM mapping supported");
+      require(m_burst_bytes == size_t(m_dram->m_internal_prefetch_size * m_dram->m_channel_width / 8),
+              "burst_bytes differs from DRAM transfer size");
+      // This mapper drops upper address bits. Check complete physical span so
+      // disjoint logical windows cannot silently alias after decode.
+      size_t span = m_burst_bytes;
+      for (int count : m_dram->m_organization.count) {
+        require(count > 0 && (count & (count - 1)) == 0
+                && span <= size_t(std::numeric_limits<Addr_t>::max()) / size_t(count), "unsupported DRAM geometry");
+        span *= count;
+      }
+      require(m_layers || size_t(std::max(m_capacity_base, m_compute_base) + m_region_bytes) <= span, "region exceeds mapped DRAM span");
+      m_tck_ps = std::lround(memory->get_tCK() * 1000.0f);
+      require(m_tck_ps > 0, "invalid DRAM clock");
+      m_read_latency = m_dram->m_read_latency;
+      m_write_latency = m_dram->m_timing_vals("nCWL") + m_dram->m_timing_vals("nBL") + m_dram->m_timing_vals("nWR");
+      m_requests << "schema_version,request_id,job_id,phase,index,type_id,address,channel,accept_cycle,command_cycle,event_cycle,callback_cycle,bytes,event";
+      if (m_layers) m_requests << ",layer_id,local_address,tck_ps";
+      m_requests << '\n';
+    }
+
+    void tick() override {
+      require(m_clk < m_max_cycles, "simulation timeout");
+      admit_jobs();
+      if (m_active < 0 && !m_queue.empty()) {
+        auto best = std::min_element(m_queue.begin(), m_queue.end(), [&](size_t a, size_t b) { return precedes(a, b); });
+        m_active = int(*best);
+        m_queue.erase(best);
+        auto& job = m_jobs[m_active];
+        job.state = 2;
+        job.start = m_clk;
+        m_buffer_bytes = job.logical;
+        m_buffer_peak = std::max(m_buffer_peak, m_buffer_bytes);
+        begin_phase(job.kind == "attention" || job.kind == "access" ? Phase::PIM : Phase::Read);
+      }
+      if (m_active >= 0) progress();
+      ++m_clk;  // At next frontend call this equals the controller's boundary.
+    }
+
+    bool is_finished() override { return m_done == m_jobs.size(); }
+
+    void finalize() override {
+      require(is_finished() && m_buffer_bytes == 0, "undrained jobs/buffer");
+      m_actual_block_cycles = m_gate->blocked_cycles();
+      m_requests.flush(); m_job_events.flush(); m_resources.flush();
+      IFrontEnd::finalize();
+    }
+
+  private:
+    bool precedes(size_t a, size_t b) const {
+      const auto& x = m_jobs[a]; const auto& y = m_jobs[b];
+      return std::make_tuple(x.priority(), x.issue, a) < std::make_tuple(y.priority(), y.issue, b);
+    }
+
+    void admit_jobs() {
+      std::vector<size_t> ready;
+      for (size_t i = 0; i < m_jobs.size(); ++i) {
+        auto& job = m_jobs[i];
+        if (job.state || job.issue > m_clk) continue;
+        bool dependencies_done = std::all_of(job.dependencies.begin(), job.dependencies.end(), [&](const auto& dep) {
+          return std::any_of(m_jobs.begin(), m_jobs.end(), [&](const Job& other) { return other.id == dep && other.state == 3; });
+        });
+        if (!dependencies_done) continue;
+        if (job.eligible < 0) job.eligible = m_clk;
+        ready.push_back(i);
+      }
+      std::sort(ready.begin(), ready.end(), [&](size_t a, size_t b) { return precedes(a, b); });
+      for (size_t index : ready) {
+        if (m_queue.size() == m_queue_depth) { ++m_admission_block_cycles; break; }
+        m_jobs[index].state = 1; m_jobs[index].admitted = m_clk;
+        m_queue.push_back(index);
+        m_queue_peak = std::max(m_queue_peak, m_queue.size());
+      }
+    }
+
+    void begin_phase(Phase phase) {
+      m_phase = phase; m_sent = 0; m_returned = 0;
+      auto& job = m_jobs[m_active];
+      m_expected = phase == Phase::PIM ? job.operations.size()
+                   : (phase == Phase::Read ? job.read_bytes : job.write_bytes) / m_burst_bytes;
+    }
+
+    void start_link(Phase phase, size_t bytes) {
+      m_phase = phase;
+      // Additional serial Base Die/TSV hop, distinct from the DRAM nBL data
+      // path. Conservative, no overlap. Quant/dequant assumed throughput matched.
+      double duration = std::ceil(double(bytes) * 1000.0 / (m_link_GBps * m_tck_ps));
+      require(duration >= 1 && duration <= double(m_max_cycles - m_clk), "link exceeds time budget");
+      m_link_until = m_clk + Clk_t(duration);
+      m_gate->block_commands_until(m_link_until);
+      if (phase == Phase::TargetLink) {
+        // DMA descriptors may enter the controller before data arrives. The
+        // controller gate must prevent ACT/WR issue until the transfer ends.
+        m_sent = 0; m_returned = 0;
+        m_expected = m_jobs[m_active].write_bytes / m_burst_bytes;
+      }
+      m_resources << "1," << m_jobs[m_active].id << ','
+                  << (phase == Phase::SourceLink ? "source_tsv_base_die" : "target_tsv_base_die")
+                  << ',' << m_clk << ',' << m_link_until << ',' << bytes << '\n';
+    }
+
+    void progress() {
+      auto& job = m_jobs[m_active];
+      if (m_phase == Phase::Read && m_returned == m_expected) start_link(Phase::SourceLink, job.read_bytes);
+      if (m_phase == Phase::SourceLink && m_clk >= m_link_until) start_link(Phase::TargetLink, job.write_bytes);
+      if (m_phase == Phase::TargetLink && m_clk >= m_link_until) m_phase = Phase::Write;
+      if (m_phase == Phase::SourceLink) return;
+
+      while (m_sent < m_expected) {
+        size_t index = m_sent;
+        bool pim = m_phase == Phase::PIM;
+        int type = pim ? job.operations[index].type : m_phase == Phase::Read ? Request::Type::Read : Request::Type::Write;
+        Addr_t address = pim ? job.operations[index].address
+                            : (m_phase == Phase::Read ? job.source : job.target) + index * m_burst_bytes;
+        Request req(address, type);
+        req.source_id = m_next_request_id;
+        auto phase = m_phase == Phase::TargetLink ? Phase::Write : m_phase;
+        req.callback = [this, index, phase](Request& completed) { returned(completed, index, phase); };
+        if (!m_memory_system->send(req)) { ++m_send_retries; break; }
+        ++m_sent; ++m_next_request_id;
+      }
+    }
+
+    void returned(Request& req, size_t index, Phase phase) {
+      require(m_active >= 0 && m_phase == phase, "callback in wrong phase");
+      auto& job = m_jobs[m_active];
+      int layer = m_layers ? m_layers->route(req.addr) : 1;
+      auto* dram = m_layer_drams[layer];
+      bool pim = req.type_id >= 4;
+      int latency = pim ? 0 : req.type_id == Request::Type::Read ? dram->m_read_latency
+                            : dram->m_timing_vals("nCWL") + dram->m_timing_vals("nBL") + dram->m_timing_vals("nWR");
+      const char* event = pim ? (req.type_id == Request::Type::PIM_BARRIER ? "barrier_removed" : "pim_final_command_issued")
+                             : req.type_id == Request::Type::Read ? "read_data_ready" : "write_recovery_done";
+      m_requests << (m_layers ? "2," : "1,") << req.source_id << ',' << job.id << ',' << (phase == Phase::PIM ? job.kind : phase == Phase::Read ? "read" : "write")
+                 << ',' << index << ',' << req.type_id << ',' << req.addr << ',' << req.addr_vec[0] << ','
+                 << req.arrive << ',' << req.depart - latency << ',' << req.depart << ',' << m_layer_controllers[layer]->get_clk()
+                 << ',' << (pim ? 0 : m_burst_bytes) << ',' << event;
+      if (m_layers) m_requests << ',' << layer << ',' << req.addr - m_layers->layer_base(layer) << ',' << m_tck_ps;
+      m_requests << '\n';
+      require(++m_returned <= m_expected, "duplicate callback");
+      if (m_returned == m_expected && (phase == Phase::PIM || phase == Phase::Write)) finish_job(req.depart);
+    }
+
+    void finish_job(Clk_t complete) {
+      auto& job = m_jobs[m_active];
+      job.complete = complete; job.state = 3; ++m_done;
+      m_job_events << "1," << job.id << ',' << job.kind << ',' << job.issue << ',' << job.eligible << ',' << job.admitted
+                   << ',' << job.start << ',' << complete << ',' << job.logical << ',' << job.read_bytes << ',' << job.write_bytes << '\n';
+      m_resources << "1," << job.id << ",channel_base_die_transaction," << job.start << ',' << complete << ",0\n";
+      m_buffer_bytes = 0; m_active = -1;
+    }
+};
+
+}  // namespace Ramulator
diff --git a/src/memory_system/impl/PIM_DRAM_system.cpp b/src/memory_system/impl/PIM_DRAM_system.cpp
new file mode 100644
index 0000000..b952158
--- /dev/null
+++ b/src/memory_system/impl/PIM_DRAM_system.cpp
@@ -0,0 +1,158 @@
+#include "memory_system/memory_system.h"
+#include "translation/translation.h"
+#include "dram_controller/controller.h"
+#include "addr_mapper/addr_mapper.h"
+#include "dram/dram.h"
+
+namespace Ramulator {
+
+class PIMDRAMSystem final : public IMemorySystem, public Implementation {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IMemorySystem, PIMDRAMSystem, "PIMDRAM", "A PIM DRAM-based memory system.");
+
+  protected:
+    Clk_t m_clk = 0;
+    IDRAM*  m_dram;
+    IAddrMapper*  m_addr_mapper;
+    std::vector<IDRAMController*> m_controllers;
+
+  public:
+    int s_num_read_requests = 0;
+    int s_num_write_requests = 0;
+    int s_num_pim_mac_all_bank_requests = 0;
+    int s_num_pim_mac_same_bank_requests = 0;
+    int s_num_pim_mac_per_bank_requests = 0;
+    int s_num_pim_write_to_gemv_buffer_requests = 0;
+    int s_num_pim_move_to_softmax_buffer_requests = 0;
+    int s_num_pim_move_to_gemv_buffer_requests = 0;
+    int s_num_pim_softmax_requests = 0;
+    int s_num_pim_set_model_requests = 0;
+    int s_num_pim_set_head_requests = 0;
+    int s_num_other_requests = 0;
+
+
+  public:
+    void init() override { 
+      // Create device (a top-level node wrapping all channel nodes)
+      m_dram = create_child_ifce<IDRAM>();
+      m_addr_mapper = create_child_ifce<IAddrMapper>();
+
+      int num_channels = m_dram->get_level_size("channel");   
+
+      // Create memory controllers
+      for (int i = 0; i < num_channels; i++) {
+        IDRAMController* controller = create_child_ifce<IDRAMController>();
+        controller->m_impl->set_id(fmt::format("Channel {}", i));
+        controller->m_channel_id = i;
+        m_controllers.push_back(controller);
+      }
+
+      m_clock_ratio = param<uint>("clock_ratio").required();
+
+      register_stat(m_clk).name("memory_system_cycles");
+      register_stat(s_num_read_requests).name("total_num_read_requests");
+      register_stat(s_num_write_requests).name("total_num_write_requests");
+      register_stat(s_num_pim_mac_all_bank_requests).name("total_num_pim_mac_all_bank_requests");
+      register_stat(s_num_pim_mac_same_bank_requests).name("total_num_pim_mac_same_bank_requests");
+      register_stat(s_num_pim_mac_per_bank_requests).name("total_num_pim_mac_per_bank_requests");
+      register_stat(s_num_pim_write_to_gemv_buffer_requests).name("total_num_pim_write_to_gemv_buffer_requests");
+      register_stat(s_num_pim_move_to_softmax_buffer_requests).name("total_num_pim_move_to_softmax_buffer_requests");
+      register_stat(s_num_pim_move_to_gemv_buffer_requests).name("total_num_pim_move_to_gemv_buffer_requests");
+      register_stat(s_num_pim_softmax_requests).name("total_num_pim_softmax_requests");
+      register_stat(s_num_pim_set_model_requests).name("total_num_pim_set_model_requests");
+      register_stat(s_num_pim_set_head_requests).name("total_num_pim_set_head_requests");
+      register_stat(s_num_other_requests).name("total_num_other_requests");
+    };
+
+    void setup(IFrontEnd* frontend, IMemorySystem* memory_system) override { }
+
+    bool send(Request req) override {
+      m_addr_mapper->apply(req);
+      int channel_id = req.addr_vec[0];
+      bool is_success = m_controllers[channel_id]->send(req);
+
+      if (is_success) {
+        switch (req.type_id) {
+          case Request::Type::Read: {
+            s_num_read_requests++;
+            break;
+          }
+          case Request::Type::Write: {
+            s_num_write_requests++;
+            break;
+          }
+          case Request::Type::PIM_MAC_AB: {
+            s_num_pim_mac_all_bank_requests++;
+            break;
+          }
+          case Request::Type::PIM_MAC_SB: {
+            s_num_pim_mac_same_bank_requests++;
+            break;
+          }
+          case Request::Type::PIM_MAC_PB: {
+            s_num_pim_mac_per_bank_requests++;
+            break;
+          }
+          case Request::Type::PIM_WR_GB: {
+            s_num_pim_write_to_gemv_buffer_requests++;
+            break;
+          }
+          case Request::Type::PIM_MV_SB: {
+            s_num_pim_move_to_softmax_buffer_requests++;
+            break;
+          }
+          case Request::Type::PIM_MV_GB: {
+            s_num_pim_move_to_gemv_buffer_requests++;
+            break;
+          }
+          case Request::Type::PIM_SFM: {
+            s_num_pim_softmax_requests++;
+            break;
+          }
+          case Request::Type::PIM_SET_MODEL: {
+            s_num_pim_set_model_requests++;
+            break;
+          }
+          case Request::Type::PIM_SET_HEAD: {
+            s_num_pim_set_head_requests++;
+            break;
+          }
+          case Request::Type::PIM_BARRIER: {
+            break;
+          }
+          default: {
+            s_num_other_requests++;
+            break;
+          }
+        }
+      }
+
+      return is_success;
+    };
+    
+    void tick() override {
+      m_clk++;
+      m_dram->tick();
+      for (auto controller : m_controllers) {
+        controller->tick();
+      }
+    };
+
+    float get_tCK() override {
+      return m_dram->m_timing_vals("tCK_ps") / 1000.0f;
+    };
+
+    // const SpecDef& get_supported_requests() override {
+    //   return m_dram->m_requests;
+    // };
+
+    bool is_pending() override {
+      bool is_pending = false;
+      for (auto controller : m_controllers) {
+        is_pending |= controller->is_pending();
+      }
+      return is_pending;
+    };
+};
+  
+}   // namespace 
+
diff --git a/src/memory_system/impl/tokenstack_fabric.cpp b/src/memory_system/impl/tokenstack_fabric.cpp
new file mode 100644
index 0000000..42aa866
--- /dev/null
+++ b/src/memory_system/impl/tokenstack_fabric.cpp
@@ -0,0 +1,293 @@
+#include <algorithm>
+#include <cmath>
+#include <deque>
+#include <fstream>
+#include <limits>
+#include <map>
+#include <set>
+#include <sstream>
+#include "memory_system/tokenstack_fabric.h"
+#include "dram_controller/controller.h"
+#include "dram_controller/tokenstack_controller.h"
+#include "addr_mapper/addr_mapper.h"
+
+namespace Ramulator {
+// Cycle-driven physical trees; all external timing assumptions are in YAML.
+// Resource calendars cover the SAME RD/WR data interval as DRAM nBL, not an
+// added pair of links. TSV intervals share a bounded byte rate; PC intervals
+// remain exclusive. This is a fluid bandwidth model at DRAM-cycle boundaries.
+class TokenStackFabric final : public IMemorySystem, public Implementation, public ITokenStackFabric {
+  RAMULATOR_REGISTER_IMPLEMENTATION(IMemorySystem, TokenStackFabric, "TokenStackFabric", "Explicit TokenStack dies and shared resource calendars.");
+  struct Layer { int stack,id; std::string kind; Addr_t base,bytes; IMemorySystem* backend; IDRAM* dram; };
+  struct Event { Clk_t end; std::function<void(Clk_t)> done; };
+  struct Interval { Clk_t start,end; int direction; size_t bytes; };
+  struct Reservation { std::string resource; Clk_t start,end; size_t bytes; int direction=0; };
+  struct Queued { Request request; size_t layer; std::string source; Clk_t accepted; };
+  std::vector<Layer> m_layers;
+  std::vector<Event> m_events;
+  std::map<std::string,std::vector<Interval>> m_calendar;
+  std::map<std::pair<int,std::string>,std::deque<Queued>> m_queues;
+  std::map<int,Clk_t> m_data_end, m_issue,m_result_end,m_write_end;
+  std::map<std::pair<size_t,int>,Clk_t> m_pim_busy;
+  std::map<std::pair<size_t,int>,Clk_t> m_dram_busy;
+  std::map<int,std::string> m_source;
+  std::map<std::pair<size_t,int>,size_t> m_inflight;
+  YAML::Node m_hw;
+  Clk_t m_clk=0,m_age=0,m_turn=0;
+  size_t m_reads=0,m_writes=0,m_pim=0,m_retries=0,m_stalls=0,m_queue_peak=0;
+  int m_tck=0,m_depth=0,m_dispatch_width=0;
+  double m_tsv=0,m_ucie=0,m_host=0;
+  std::ofstream m_commands,m_resources,m_event_log;
+  static void check(bool ok,const std::string& message) { if(!ok) throw ConfigurationError("TokenStackFabric: {}",message); }
+  static int priority(const std::string& source) {return source=="gpu"||source=="pim" ? 0 : source=="promotion" ? 1 : 2;}
+  std::string stack_key(const std::string& type,int stack) const {return type+"/s"+std::to_string(stack);}
+  std::string channel_key(size_t layer,int channel) const {
+    return "channel/s"+std::to_string(m_layers[layer].stack)+"/ch"+std::to_string(channel);
+  }
+  Clk_t transfer(size_t bytes,double gbps) const {
+    return std::max<Clk_t>(1,Clk_t(std::ceil(double(bytes)*1000.0/(gbps*m_tck))));
+  }
+  bool available(const Reservation& r) const {
+    const bool shared=r.resource.rfind("tsv/",0)==0;
+    const long double limit=m_tsv*m_tck/1000.0L;
+    const long double rate=static_cast<long double>(r.bytes)/(r.end-r.start);
+    if(shared && rate>limit+1e-9L)return false;
+    auto it=m_calendar.find(r.resource); if(it==m_calendar.end()) return true;
+    std::map<Clk_t,long double> changes;
+    if(shared) {changes[r.start]+=rate;changes[r.end]-=rate;}
+    for(const auto& old:it->second) {
+      const Clk_t guard=(r.direction && old.direction && r.direction!=old.direction)?m_turn:0;
+      const bool opposite=r.direction && old.direction && r.direction!=old.direction;
+      if((!shared || opposite) && r.start<old.end+guard && old.start<r.end+guard) return false;
+      if(shared && r.start<old.end && old.start<r.end) {
+        const long double old_rate=static_cast<long double>(old.bytes)/(old.end-old.start);
+        changes[std::max(r.start,old.start)]+=old_rate;
+        changes[std::min(r.end,old.end)]-=old_rate;
+      }
+    }
+    long double used=0;
+    for(const auto& [cycle,delta]:changes) {used+=delta;if(used>limit+1e-9L)return false;}
+    return true;
+  }
+  bool reserve(const std::vector<Reservation>& requests,int tag,const std::string& source) {
+    for(const auto& r:requests) {check(r.end>r.start,"invalid resource interval"); if(!available(r)) return false;}
+    for(const auto& r:requests) {
+      m_calendar[r.resource].push_back({r.start,r.end,r.direction,r.bytes});
+      m_resources<<"1,"<<tag<<','<<source<<','<<r.resource<<','<<r.start<<','<<r.end<<','<<r.bytes<<','<<r.direction<<'\n';
+    }
+    return true;
+  }
+  bool command(size_t layer_index,Request& request,Clk_t cycle) {
+    auto& layer=m_layers[layer_index];auto* dram=layer.dram;
+    const int channel=request.addr_vec[0];
+    const std::string channel_resource=channel_key(layer_index,channel);
+    const auto unit_key=std::make_pair(layer_index,channel);
+    if(m_pim_busy[unit_key]>cycle) {++m_stalls;return false;}
+    // The inherited PIM timing table has no complete cross-mode RD/WR->MAC
+    // completion relation. Explicit physical-die mode conservatively drains
+    // ordinary data/recovery before PIM prerequisites can change bank state.
+    if(request.type_id>=4 && m_dram_busy[unit_key]>cycle) {++m_stalls;return false;}
+    const auto cmd=std::string(dram->m_commands(request.command));
+    const auto source=request.source_id<0 ? "maintenance" : m_source.at(request.source_id);
+    std::vector<Reservation> reservations={{channel_resource,cycle,cycle+1,0}};
+    Clk_t tail=0;
+    if(request.type_id>=4 && request.type_id<=12 && request.command==request.final_command) {
+      const char* key=request.type_id<=6 ? "mac_tail_cycles" : request.type_id<=9 ? "move_tail_cycles" : request.type_id==10 ? "softmax_tail_cycles" : "mode_tail_cycles";
+      tail=m_hw["pim"][key].as<Clk_t>();check(tail>0,"PIM result tail must be positive and explicit");
+      reservations.push_back({"pim/s"+std::to_string(layer.stack)+"/d"+std::to_string(layer.id)+"/ch"+std::to_string(channel),cycle,cycle+tail,0});
+      if(request.type_id==10) reservations.push_back({stack_key("coordinator",layer.stack),cycle,cycle+tail,0});
+    }
+    const bool rd=cmd=="RD",wr=cmd=="WR";
+    if(rd||wr) {
+      const Clk_t delay=dram->m_timing_vals(rd?"nCL":"nCWL");
+      const Clk_t length=std::max<Clk_t>(dram->m_timing_vals("nBL"),transfer(32,m_tsv));
+      const int direction=rd?1:2;
+      const auto data_start=cycle+delay, data_end=data_start+length;
+      reservations.push_back({stack_key("tsv",layer.stack),data_start,data_end,32,direction});
+      reservations.push_back({channel_resource+"/pc"+std::to_string(request.addr_vec[1])+"/data",data_start,data_end,32,direction});
+      if(!reserve(reservations,request.source_id,source)) {++m_stalls;return false;}
+      m_data_end[request.source_id]=data_end;
+      const Clk_t recovery=data_end+(wr?dram->m_timing_vals("nWR"):0);
+      m_dram_busy[unit_key]=std::max(m_dram_busy[unit_key],recovery);
+      if(wr)m_write_end[request.source_id]=recovery;
+    } else if(!reserve(reservations,request.source_id,source)) {++m_stalls;return false;}
+    if(tail) {m_result_end[request.source_id]=cycle+tail;m_pim_busy[unit_key]=cycle+tail;}
+    if(request.source_id>=0 && request.command==request.final_command) m_issue[request.source_id]=cycle;
+    m_commands<<"1,"<<cycle<<','<<layer.stack<<','<<layer.id<<','<<request.source_id<<','<<source<<','<<cmd;
+    for(int coordinate:request.addr_vec) m_commands<<','<<coordinate;
+    m_commands<<'\n'; return true;
+  }
+  size_t route(Addr_t address) const {
+    for(size_t i=0;i<m_layers.size();++i) if(address>=m_layers[i].base && address<m_layers[i].base+m_layers[i].bytes) return i;
+    throw ConfigurationError("TokenStackFabric: address outside physical dies");
+  }
+  void dispatch() {
+    // Bounded per-stack source queues; preserve per-channel source order while
+    // allowing independent channels to issue through a configurable ingress.
+    std::vector<std::pair<int,std::string>> candidates;
+    for(auto& [key,queue]:m_queues) if(!queue.empty()) candidates.push_back(key);
+    std::stable_sort(candidates.begin(),candidates.end(),[&](const auto& a,const auto& b){
+      const auto& x=m_queues.at(a).front();const auto& y=m_queues.at(b).front();
+      bool xa=m_clk-x.accepted>=m_age,ya=m_clk-y.accepted>=m_age;
+      return std::make_tuple(!xa,xa?0:priority(x.source),x.accepted,a)<std::make_tuple(!ya,ya?0:priority(y.source),y.accepted,b);
+    });
+    for(auto key:candidates) {
+      auto& queue=m_queues.at(key);int admitted=0;
+      std::set<std::pair<size_t,int>> blocked;
+      for(auto item=queue.begin();item!=queue.end() && admitted<m_dispatch_width;) {
+        auto& layer=m_layers[item->layer];Request probe=item->request;
+        layer.backend->get_ifce<IAddrMapper>()->apply(probe);
+        const auto count_key=std::make_pair(item->layer,probe.addr_vec[0]);
+        if(blocked.count(count_key) || m_inflight[count_key]>=size_t(m_depth) || !layer.backend->send(item->request)) {
+          blocked.insert(count_key);++item;
+        } else {++m_inflight[count_key];++admitted;item=queue.erase(item);}
+      }
+    }
+  }
+ public:
+  void init() override {
+    m_clock_ratio=param<uint>("clock_ratio").required();check(m_clock_ratio==1,"requires 1:1 clocks");
+    m_hw=m_config["hardware"];auto resources=m_hw["resources"];
+    m_depth=resources["queue_depth_per_source"].as<int>();m_age=resources["aging_cycles"].as<Clk_t>();
+    m_dispatch_width=resources["dispatch_per_source_cycle"].as<int>();
+    m_turn=resources["tsv_turnaround_cycles"].as<Clk_t>();
+    m_tsv=resources["tsv_GBps"].as<double>();m_ucie=resources["ucie_GBps"].as<double>();m_host=resources["host_crossbar_GBps"].as<double>();
+    check(m_depth>0 && m_dispatch_width>0 && m_age>0 && m_turn>=0 && std::isfinite(m_tsv) && m_tsv>0 && std::isfinite(m_ucie) && m_ucie>0
+          && std::isfinite(m_host) && m_host>0,"invalid queue/link parameters");
+    check(resources["tsv_coverage"].as<std::string>()=="dram_data_burst" && resources["command_slots_per_channel_cycle"].as<int>()==1,"unsupported resource profile");
+    check(resources["tsv_arbitration"].as<std::string>()=="shared_rate","unsupported TSV arbitration");
+    check(m_config["layers"].IsSequence() && m_config["layers"].size()>0,"empty layers");
+    std::set<std::pair<int,int>> ids;
+    for(auto entry:m_config["layers"]) {
+      Layer layer{entry["stack"].as<int>(),entry["die_id"].as<int>(),entry["kind"].as<std::string>(),entry["base"].as<Addr_t>(),entry["bytes"].as<Addr_t>(),nullptr,nullptr};
+      check(layer.stack>=0 && layer.stack<m_hw["stacks"].as<int>() && layer.id>=0 && ids.emplace(layer.stack,layer.id).second,"duplicate/invalid layer");
+      check(layer.kind=="capacity"||layer.kind=="compute","invalid layer kind");
+      check(layer.base>=0 && layer.base%32==0 && layer.bytes>0 && layer.base<=std::numeric_limits<Addr_t>::max()-layer.bytes,"invalid address interval");
+      for(const auto& old:m_layers) check(layer.base+layer.bytes<=old.base || old.base+old.bytes<=layer.base,"overlapping physical dies");
+      YAML::Node config;config["MemorySystem"]=YAML::Clone(entry["backend"]);layer.backend=Factory::create_memory_system(config);
+      check(entry["backend"]["DRAM"]["tokenstack_physical_dies"].as<bool>(false),"physical-die broadcast checks must be enabled");
+      layer.dram=layer.backend->get_ifce<IDRAM>();auto* dram=layer.dram;
+      check(dram->m_impl->get_name()=="HBM3-PIM" && layer.backend->get_clock_ratio()==1,"unsupported backend");
+      size_t span=dram->m_internal_prefetch_size*dram->m_channel_width/8;check(span==32,"requires 32-byte burst");
+      for(int count:dram->m_organization.count) {check(count>0 && (count&(count-1))==0 && span<=size_t(std::numeric_limits<Addr_t>::max())/count,"invalid geometry");span*=count;}
+      check(size_t(layer.bytes)==span,"capacity/geometry disagreement");
+      int clock=std::lround(layer.backend->get_tCK()*1000);check(m_tck==0||m_tck==clock,"clock mismatch");m_tck=clock;
+      m_layers.push_back(layer);
+    }
+    m_commands.open(param<std::string>("command_log").required());m_resources.open(param<std::string>("resource_log").required());m_event_log.open(param<std::string>("event_log").required());
+    check(m_commands.is_open()&&m_resources.is_open()&&m_event_log.is_open(),"cannot open fabric logs");
+    m_commands<<"schema_version,cycle,stack,die_id,request_id,source,command,channel,pseudochannel,rank,bankgroup,bank,row,column\n";
+    m_resources<<"schema_version,tag,source,resource,start_cycle,end_cycle,bytes,direction\n";
+    m_event_log<<"schema_version,request_id,type,stack,die_id,accept_cycle,issue_cycle,operand_ready_cycle,data_ready_cycle,result_ready_cycle,complete_cycle\n";
+    register_stat(m_clk).name("memory_system_cycles");register_stat(m_reads).name("total_num_read_requests");register_stat(m_writes).name("total_num_write_requests");register_stat(m_pim).name("total_num_pim_requests");
+    register_stat(m_stalls).name("fabric_command_resource_stalls");register_stat(m_queue_peak).name("fabric_source_queue_peak");register_stat(m_retries).name("fabric_queue_backpressure");
+  }
+  void connect_frontend(IFrontEnd* frontend) override {
+    IMemorySystem::connect_frontend(frontend);
+    for(size_t i=0;i<m_layers.size();++i) {
+      auto& layer=m_layers[i];layer.backend->connect_frontend(frontend);
+      for(int ch=0;ch<layer.dram->get_level_size("channel");++ch) {
+        auto* controller=layer.backend->get_ifce<IDRAMController>("Channel "+std::to_string(ch));
+        auto* gate=dynamic_cast<ITokenStackController*>(controller);check(gate,"controller lacks arbitration capability");
+        gate->set_command_arbiter([this,i](Request& request,Clk_t cycle){return command(i,request,cycle);});
+      }
+    }
+  }
+  bool send(Request req) override {return submit(req,req.type_id<2?"gpu":"pim");}
+  bool submit(Request req,const std::string& source) override {
+    check(source=="gpu"||source=="pim"||source=="promotion"||source=="demotion","invalid request source");
+    const auto layer_index=route(req.addr);auto& layer=m_layers[layer_index];
+    check(req.addr%32==0 && req.addr<=layer.base+layer.bytes-32,"unaligned/out-of-bounds burst");
+    check(req.type_id==0||req.type_id==1||(req.type_id>=4 && req.type_id<=13 && layer.kind=="compute"),"PIM forbidden on Capacity / invalid type");
+    auto& queue=m_queues[{layer.stack,source}];if(queue.size()>=size_t(m_depth)) {++m_retries;return false;}
+    check(req.source_id>=0 && !m_source.count(req.source_id),"request ID reused or absent");
+    const auto callback=req.callback;const auto global=req.addr;const auto accepted=m_clk;const auto id=req.source_id;
+    req.addr-=layer.base;m_source[id]=source;
+    req.callback=[this,callback,global,accepted,layer_index,id](Request& completed){
+      Request visible=completed;visible.addr=global;
+      const auto key=std::make_pair(layer_index,completed.addr_vec[0]);check(m_inflight[key]>0,"inflight underflow");
+      --m_inflight[key];
+      const auto issue=m_issue.count(id)?m_issue.at(id):completed.depart;
+      // A scheduler barrier cannot release before already issued PIM results.
+      const auto result=completed.type_id==13 ? std::max(completed.depart,m_pim_busy[key]) : m_result_end.count(id)?m_result_end.at(id):-1;
+      const auto end=std::max({completed.depart,m_data_end.count(id)?m_data_end.at(id):completed.depart,result,
+                              m_write_end.count(id)?m_write_end.at(id):completed.depart});
+      const auto data=m_data_end.count(id)?m_data_end.at(id):-1;
+      const auto& layer=m_layers[layer_index];
+      m_event_log<<"1,"<<id<<','<<completed.type_id<<','<<layer.stack<<','<<layer.id<<','<<accepted<<','<<issue<<','
+                 <<(completed.type_id>=4?issue:-1)<<','<<data<<','<<result<<','<<end<<'\n';
+      visible.depart=end;
+      if(end>m_clk) m_events.push_back({end,[callback,visible](Clk_t) mutable {if(callback)callback(visible);}});
+      else if(callback)callback(visible);
+    };
+    queue.push_back({req,layer_index,source,accepted});m_queue_peak=std::max(m_queue_peak,queue.size());
+    if(req.type_id==0)++m_reads;else if(req.type_id==1)++m_writes;else ++m_pim;
+    return true;
+  }
+  bool work(int tag,int stack,const std::string& resource,size_t bytes,Clk_t cycles,const std::string& source,std::function<void(Clk_t)> done) override {
+    check(stack>=0 && stack<m_hw["stacks"].as<int>() && cycles>=0,"invalid work stack/duration");
+    check(source=="gpu"||source=="pim"||source=="promotion"||source=="demotion","invalid work source");
+    double bandwidth=0;std::string key;bool tsv=false;
+    if(resource=="ucie") {key=stack_key("ucie",stack);bandwidth=m_ucie;}
+    else if(resource=="host") {key="gpu_crossbar";bandwidth=m_host;}
+    else if(resource=="convert") {key=stack_key("convert",stack);bandwidth=m_hw["base_die"]["conversion_GBps"].as<double>();}
+    else if(resource=="transpose") {key=stack_key("layout",stack);bandwidth=m_hw["base_die"]["transpose_GBps"].as<double>();}
+    else if(resource=="coordinator") {key=stack_key("coordinator",stack);bandwidth=m_hw["pim"]["coordinator_GBps"].as<double>();tsv=true;}
+    else if(resource=="gpu_compute") {
+      check(m_hw["gpu_system"] && m_hw["gpu_system"]["model"].as<std::string>()=="A100a"
+            && m_hw["gpu_system"]["devices"].as<int>()==1,"GPU work requires explicit single-card A100a profile");
+      check(source=="gpu" && bytes==0 && cycles>0,"invalid GPU compute work");
+      key="gpu_compute/card0";
+    }
+    else if(resource=="delay") {key="delay/"+std::to_string(tag);}
+    else throw ConfigurationError("TokenStackFabric: unknown work resource {}",resource);
+    check(resource=="delay" || resource=="gpu_compute" || (std::isfinite(bandwidth)&&bandwidth>0),"invalid work bandwidth");
+    Clk_t length=std::max<Clk_t>(std::max<Clk_t>(1,cycles),bandwidth>0?transfer(bytes,bandwidth):1);
+    if(tsv)length=std::max(length,transfer(bytes,m_tsv));
+    // A streaming engine can pipeline pages; each conversion/layout stage uses
+    // one execution lane. Descriptor/page lifetime is bounded by SRAM slots.
+    if(resource=="convert" || resource=="transpose") {
+      const int engines=m_hw["base_die"]["dma_engines"].as<int>();check(engines>0,"invalid DMA engine count");
+      bool found=false;
+      for(int e=0;e<engines;++e) {
+        std::string candidate=key+(e?"/e"+std::to_string(e):"");
+        if(available({candidate,m_clk,m_clk+length,bytes})) {key=candidate;found=true;break;}
+      }
+      if(!found)return false;
+    }
+    std::vector<Reservation> reservations={{key,m_clk,m_clk+length,bytes}};
+    if(tsv) reservations.push_back({stack_key("tsv",stack),m_clk,m_clk+std::max(length,transfer(bytes,m_tsv)),bytes});
+    if(!reserve(reservations,tag,source)) return false;
+    m_events.push_back({m_clk+length,done});return true;
+  }
+  void tick() override {
+    ++m_clk;dispatch();
+    // Rotate die traversal: fixed first-die priority would starve later dies
+    // sharing a command bus. Backend clocks/callbacks/refresh always tick.
+    for(size_t n=0;n<m_layers.size();++n) m_layers[(n+size_t(m_clk))%m_layers.size()].backend->tick();
+    std::vector<Event> ready;auto it=m_events.begin();
+    while(it!=m_events.end()) {if(it->end<=m_clk){ready.push_back(*it);it=m_events.erase(it);}else ++it;}
+    for(auto& event:ready)event.done(event.end);
+    // Keep one old turnaround guard interval; completed history lives in CSV.
+    for(auto& [key,calendar]:m_calendar) calendar.erase(std::remove_if(calendar.begin(),calendar.end(),[&](const auto& r){return r.end+m_turn<m_clk;}),calendar.end());
+  }
+  float get_tCK() override {return m_tck/1000.0f;}
+  bool is_pending() override {
+    if(!m_events.empty())return true;
+    for(const auto& [key,queue]:m_queues)if(!queue.empty())return true;
+    for(auto& layer:m_layers)if(layer.backend->is_pending())return true;
+    return false;
+  }
+  void finalize() override {
+    m_commands.flush();m_resources.flush();m_event_log.flush();
+    YAML::Emitter emitter;emitter<<YAML::BeginMap;m_impl->print_stats(emitter);
+    emitter<<YAML::Key<<"PhysicalDies"<<YAML::Value<<YAML::BeginSeq;
+    for(auto& layer:m_layers) {
+      std::ostringstream stream;auto* old=std::cout.rdbuf(stream.rdbuf());layer.backend->finalize();std::cout.rdbuf(old);
+      emitter<<YAML::BeginMap<<YAML::Key<<"stack"<<YAML::Value<<layer.stack<<YAML::Key<<"die_id"<<YAML::Value<<layer.id<<YAML::Key<<"kind"<<YAML::Value<<layer.kind
+             <<YAML::Key<<"bytes"<<YAML::Value<<layer.bytes<<YAML::Key<<"stats"<<YAML::Value<<YAML::Load(stream.str())["MemorySystem"]<<YAML::EndMap;
+    }
+    emitter<<YAML::EndSeq<<YAML::EndMap;std::cout<<emitter.c_str()<<std::endl;
+  }
+};
+}
diff --git a/src/memory_system/impl/tokenstack_memory.cpp b/src/memory_system/impl/tokenstack_memory.cpp
