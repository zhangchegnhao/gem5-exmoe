+      m_wr_high_watermark = param<float>("wr_high_watermark").desc("Threshold for switching to write mode.").default_val(0.8f);
+
+      m_scheduler = create_child_ifce<IScheduler>();
+      m_refresh = create_child_ifce<IRefreshManager>();    
